      "cmd": "out=$(gofmt -l . 2\u003e\u00261); c=$?; printf '%s\\n' \"$out\"; if [ $c -ne 0 ]; then exit $c; fi; test -z \"$out\""
    },
    "tests": {
      "cmd": "go test ./..."
    },
    "types": {
      "cmd": "go vet ./..."
    }
  }
}
